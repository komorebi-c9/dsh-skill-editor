{
  "name": "dsh-skill-editor",
  "description": "Browse and edit the skills directory in a VSCode-style file tree and editor panel in the sidebar",
  "version": "1.0.0",
  "private": true,
  "license": "MIT",
  "author": "komorebi-c9",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/komorebi-c9/dsh-skill-editor.git"
  },
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": ["index.js", "client.js", "cordis.patch.yml", "locale/*.json", "icon.svg"],
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  }
}
